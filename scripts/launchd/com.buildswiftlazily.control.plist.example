<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buildswiftlazily.control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/src/buildswiftlazily/apps/control-plane" &amp;&amp; /usr/bin/env npm start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/src/buildswiftlazily/apps/control-plane</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/buildswiftlazily.control.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/buildswiftlazily.control.err</string>
</dict>
</plist>
