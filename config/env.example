# Copy to repo root as `.env` (gitignored) and fill in.
# bootstrap.sh creates this file and generates BSL_API_TOKEN when missing.

# Tailscale MagicDNS hostname of this Mac (no https://)
BSL_TS_HOST=your-mac.tailnet-xxxx.ts.net

# Local ports
BSL_CONTROL_PORT=8787
BSL_OTA_PORT=8788

# Apple team ID (10 chars)
BSL_TEAM_ID=XXXXXXXXXX

# Optional: login keychain password so local builds can unlock signing keys
# after the Mac sleeps (never commit; .env should be chmod 600).
# Prefer one-time: ./scripts/prepare-keychain.sh  (stops codesign GUI prompts)
# BSL_KEYCHAIN_PASSWORD=
# BSL_KEYCHAIN_LOCK_SECONDS=86400

# Artifact root on the Mac
BSL_ARTIFACT_ROOT=~/buildswiftlazily/artifacts
# Expire www/ota, leftover work/ checkouts, and builds/ trees after this many days.
# DerivedData / .xcarchive / source checkouts are also deleted when each job ends.
BSL_ARTIFACT_TTL_DAYS=7
# Set to 1 to keep DerivedData + work checkouts after a job (debug only; disk hog).
# BSL_KEEP_BUILD_INTERMEDIATES=1

# GitHub — fine-grained PAT available to the control plane
# Contents: Read on repos you build
# Actions: Write on your buildswiftlazily fork (only if using Actions engine)
GITHUB_TOKEN=

# Copy gitignored files into the GitHub tarball checkout before xcodebuild.
# Comma- or newline-separated dest=src pairs (dest is relative to repo root).
# Example (GuideAI Firebase config is gitignored):
# BSL_CHECKOUT_INJECT=ios/GuideAI/GoogleService-Info.plist=~/src/GuideAI/ios/GuideAI/GoogleService-Info.plist
# BSL_CHECKOUT_INJECT=

# Cursor Cloud Agents API key from https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Where deploy-ios.yml lives (Actions engine only; local engine ignores these)
# Set to your fork after cloning/forking:
BSL_TOOLING_REPO=YOUR_GITHUB_USER/buildswiftlazily
BSL_TOOLING_REF=main

# Optional: default favorite app slug (also set in config/repos.yaml)
BSL_GUIDEAI_REPO=YOUR_ORG_OR_USER/YourApp

# Deploy engine: local (default, runs on this Mac) | actions (self-hosted runner)
BSL_DEPLOY_ENGINE=local

# Required shared secret for the control-plane API (except /api/health).
# When unset, the API rejects non-health routes unless BSL_ALLOW_INSECURE_API=1.
# Generate with: openssl rand -hex 24
# bootstrap.sh auto-fills this when missing — paste into PWA Status → API token.
BSL_API_TOKEN=
# Dev/smoke only — never enable on a Tailscale-exposed Mac:
# BSL_ALLOW_INSECURE_API=1

# App Store Connect API key for TestFlight uploads
BSL_ASC_KEY_ID=
BSL_ASC_ISSUER_ID=
# Directory containing AuthKey_<KEY_ID>.p8 (default ~/.appstoreconnect/private_keys)
# BSL_ASC_KEY_PATH=~/.appstoreconnect/private_keys
# Numeric App Store Connect Apple ID (App Information page). Required by
# altool --upload-package; without it the IPA is not delivered (altool ERROR 21
# can still exit 0). Looked up via ASC API / altool --list-apps when unset.
# BSL_ASC_APPLE_ID=
