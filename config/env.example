# Copy to repo root as `.env` (gitignored) and fill in.

# Tailscale MagicDNS hostname of this Mac (no https://)
BSL_TS_HOST=your-mac.tailnet-xxxx.ts.net

# Local ports
BSL_CONTROL_PORT=8787
BSL_OTA_PORT=8788

# Apple team ID (10 chars)
BSL_TEAM_ID=XXXXXXXXXX

# Artifact root on the Mac
BSL_ARTIFACT_ROOT=~/buildswiftlazily/artifacts
BSL_ARTIFACT_TTL_DAYS=7

# GitHub — fine-grained PAT or `gh auth` token available to the control plane
# Contents: Read on personal + GuideAI repos
# Actions: Write on isaacy13/buildswiftlazily (to dispatch workflows)
GITHUB_TOKEN=

# Cursor Cloud Agents API key from https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Branch of buildswiftlazily that contains deploy-ios.yml
# (workflow_dispatch must target a branch where the workflow file exists)
# Until deploy-ios.yml is merged to main, set this to your PR branch, e.g.:
#   BSL_TOOLING_REF=cursor/self-hosted-ios-deployment-706f
# bootstrap.sh auto-sets this when you're on a feature branch. Local engine ignores it.
BSL_TOOLING_REPO=isaacy13/buildswiftlazily
BSL_TOOLING_REF=main

# Optional: default GuideAI slug if not only in repos.yaml
BSL_GUIDEAI_REPO=YOUR_ORG_OR_USER/GuideAI

# Deploy engine: local (default, runs on this Mac) | actions (GitHub Actions runner)
BSL_DEPLOY_ENGINE=local

# Optional shared secret for the control-plane API (recommended).
# When set, the PWA/API require Authorization: Bearer <token> or X-BSL-Token.
# Generate with: openssl rand -hex 24
# BSL_API_TOKEN=

# App Store Connect API key for TestFlight uploads
BSL_ASC_KEY_ID=
BSL_ASC_ISSUER_ID=
# Directory containing AuthKey_<KEY_ID>.p8 (default ~/.appstoreconnect/private_keys)
# BSL_ASC_KEY_PATH=~/.appstoreconnect/private_keys
